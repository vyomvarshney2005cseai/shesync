{
  "expo": {
    "name": "SheSync",
    "slug": "shesync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shesync",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF0F5",
        "foregroundImage": "./assets/images/shesync-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vyomvarshney1234.shesync"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vyomvarshney1234.shesync"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF0F5",
          "image": "./assets/images/shesync-logo.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SheSync uses the microphone only while you record a voice journal entry.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SheSync uses the microphone only while you record a voice journal entry.",
          "speechRecognitionPermission": "SheSync turns your voice journal into text on this phone. Your voice is not uploaded.",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.tts",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SheSync uses Face ID to unlock the app and keep your health data private."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b11ee22c-0df1-4bd3-b1b4-27bbccecb37e"
      }
    }
  }
}
